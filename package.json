{
  "name": "agent-trace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local execution evidence shared by agent-stats and agent-knowledge",
  "bin": {
    "agent-trace": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "agent-trace.service.example.json"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "cli": "node src/cli.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm test && npm run build",
    "verify:consumers": "node scripts/verify-consumers.ts",
    "verify:follow": "node scripts/verify-follow.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
